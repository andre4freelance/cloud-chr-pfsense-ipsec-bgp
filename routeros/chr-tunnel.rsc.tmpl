# MikroTik CHR — Alibaba Cloud end of the multi-cloud tunnel
#
# Template. Substitute the @@PLACEHOLDERS@@ (apply.sh does this from vars.env)
# and feed the result to the device. Every line is idempotent-safe to re-run
# EXCEPT the `add` commands, which duplicate — apply.sh removes the matching
# objects first. Never commit a rendered copy: it contains the PSK.
#
# Applies to infrastructure built by terraform/aliyun-vm. Assumes ether1 is on
# the public vswitch and ether2 on the private one.

# --- Management ports --------------------------------------------------------
# Moved off the defaults. The cloud security group must allow the SAME ports or
# the device becomes unreachable the moment this is applied.
/ip service
set ssh port=@@CHR_SSH_PORT@@
set winbox port=@@CHR_WINBOX_PORT@@
set ftp disabled=yes
set telnet disabled=yes
set www disabled=yes
set api disabled=yes
set api-ssl disabled=yes

# --- Addressing --------------------------------------------------------------
/ip dhcp-client
add interface=ether1 name=client1
add interface=ether2 name=client2 add-default-route=no use-peer-dns=no use-peer-ntp=no

# Large fragment threshold: GRE inside IPsec produces packets the default
# threshold handles poorly.
/ip settings
set ipv4-high-fragment-thresh=16.0MiB

# --- IPsec -------------------------------------------------------------------
# Both endpoints are behind 1:1 NAT, so:
#   * my-id / remote-id must be the PUBLIC addresses; the interface addresses
#     are private and the peer would reject them
#   * NAT-T is used automatically, ESP is carried inside UDP 4500
#   * the policy matches on protocol=gre between this device's PRIVATE address
#     and the peer's PUBLIC address — that pairing is what the far side mirrors
/ip ipsec profile
add name=azure dh-group=modp2048 enc-algorithm=aes-256 hash-algorithm=sha256 lifetime=8h

/ip ipsec proposal
add name=azure auth-algorithms=sha256 enc-algorithms=aes-256-cbc,aes-256-ctr,aes-256-gcm \
    pfs-group=modp2048 lifetime=1h

/ip ipsec peer
add name=azure address=@@PEER_PUBLIC_IP@@/32 exchange-mode=ike2 profile=azure \
    local-address=@@CHR_PRIVATE_IP@@

/ip ipsec identity
add peer=azure auth-method=pre-shared-key secret="@@IPSEC_PSK@@" \
    my-id=address:@@CHR_PUBLIC_IP@@ remote-id=address:@@PEER_PUBLIC_IP@@

/ip ipsec policy
add peer=azure tunnel=yes protocol=gre \
    src-address=@@CHR_PRIVATE_IP@@/32 dst-address=@@PEER_PUBLIC_IP@@/32 \
    sa-src-address=@@CHR_PRIVATE_IP@@ sa-dst-address=@@PEER_PUBLIC_IP@@ \
    proposal=azure

# --- GRE ---------------------------------------------------------------------
# keepalive is DELIBERATELY absent: FreeBSD's gre(4) on the pfSense side never
# answers GRE keepalives, so RouterOS would decide the link is down every few
# seconds and take BGP with it. Liveness comes from the BGP hold timer and DPD.
#
# allow-fast-path=no because fast path bypasses processing that GRE-over-IPsec
# depends on. MTU must match the far end exactly, and must be the MEASURED
# end-to-end path MTU (ping -M do from both ends), not a nominal figure — see
# the MSS section below for what happens when it is 12 bytes optimistic.
/interface gre
add name=gre-azure local-address=@@CHR_PRIVATE_IP@@ remote-address=@@PEER_PUBLIC_IP@@ \
    mtu=@@TUNNEL_MTU@@ allow-fast-path=no !keepalive

/ip address
add address=@@CHR_TUNNEL_IP@@/30 interface=gre-azure network=@@TUNNEL_NETWORK@@

# --- TCP MSS clamping ---------------------------------------------------------
# `clamp-tcp-mss=yes` on the GRE interface derives its clamp from that
# interface's MTU. That is the tunnel's NOMINAL MTU, which is not the same as
# the end-to-end path MTU once IPsec/NAT-T overhead is counted. With mtu=1400
# against a measured path of 1388 it produced segments 12 bytes too large:
# handshakes and small requests succeeded, bulk transfers vanished with no error
# at either end. A `kubeadm join` across the tunnel failed while "reading the
# response body" of a ConfigMap — which reads like an API problem, not an MTU one.
#
# Clamp explicitly to the measured path MTU minus 40 instead. TWO rules, because
# the SYN of a flow and the SYN-ACK of that same flow traverse this device on
# OPPOSITE interfaces. Clamping at this single transit point therefore covers
# both directions of every TCP flow between the two clouds, and the peer
# appliance needs no clamping of its own.
/ip firewall mangle
add chain=forward action=change-mss new-mss=@@TUNNEL_MSS@@ passthrough=yes \
    protocol=tcp tcp-flags=syn out-interface=gre-azure \
    comment="clamp tcp mss to the measured path mtu"
add chain=forward action=change-mss new-mss=@@TUNNEL_MSS@@ passthrough=yes \
    protocol=tcp tcp-flags=syn in-interface=gre-azure \
    comment="clamp tcp mss to the measured path mtu"

# --- Routing -----------------------------------------------------------------
# The VPC supernet is not a connected route (only the per-subnet /24s are), and
# BGP will not advertise a prefix that is absent from the routing table. The
# next-hop is an INTERFACE, not a gateway address, so this line is portable.
/ip route
add dst-address=@@VPC_SUPERNET@@ gateway=ether2 distance=1 comment="vpc network"

# --- BGP ---------------------------------------------------------------------
# Outbound filter is an allow-list. Two things must never leave:
#   * the tunnel transport /30
#   * anything covering the peer's public address
# Advertising either hands the far end a route to this tunnel's own endpoint
# through the tunnel — a recursion that collapses the link.
/routing filter rule
add chain=azure-out rule="if (dst == @@LOCAL_PUBLIC_SUBNET@@ || dst == @@LOCAL_PRIVATE_SUBNET@@ || dst == @@VPC_SUPERNET@@) { accept } reject"
add chain=azure-in  rule="if (dst == 0.0.0.0/0 || dst in @@PEER_PUBLIC_IP@@/32) { reject } accept"

/routing bgp instance
add name=aliyun as=@@LOCAL_ASN@@ router-id=@@CHR_PRIVATE_IP@@ disabled=no

/routing bgp template
add name=aliyun as=@@LOCAL_ASN@@

/routing bgp connection
add name=pfsense-azure instance=aliyun templates=aliyun as=@@LOCAL_ASN@@ \
    local.address=@@CHR_TUNNEL_IP@@ .role=ebgp \
    remote.address=@@PEER_TUNNEL_IP@@/32 .as=@@PEER_ASN@@ \
    input.filter=azure-in output.filter-chain=azure-out .redistribute=connected,static \
    routing-table=main disabled=no

# --- NAT ---------------------------------------------------------------------
# The private subnet reaches the internet through this device, so it needs
# source NAT on the way out. The `dst-address=!` exclusion is the important
# part: traffic to the REMOTE CLOUD must keep its real source address, because
# the far side routes the reply back by that address. NAT it and the return
# packet is addressed to this router instead of the originating host, and the
# session dies with no error anywhere obvious.
/ip firewall nat
add chain=srcnat action=masquerade out-interface=ether1 \
    src-address=@@LOCAL_PRIVATE_SUBNET@@ dst-address=!@@PEER_SUPERNET@@ \
    comment="NAT private subnet to the internet, never to the peer"

# --- Port-forward into the private subnet -------------------------------------
# dst-nat alone is NOT enough on a cloud whose private security group filters by
# source. dst-nat rewrites only the DESTINATION, so the packet still arrives at
# the target carrying the original external source address - which the security
# group does not recognise, and drops. The paired srcnat below makes it arrive
# from the appliance instead, which the intra-VPC rule already permits.
#
# Uncomment and adjust per host; the port must sit inside the range opened on
# the security group by terraform (nat_port_range).
#
# /ip firewall nat
# add chain=dstnat action=dst-nat protocol=tcp \
#     dst-address=@@CHR_PRIVATE_IP@@ dst-port=20022 \
#     to-addresses=<private host> to-ports=22 comment="natfwd: SSH to <host>"
# add chain=srcnat action=masquerade protocol=tcp \
#     dst-address=<private host> dst-port=22 out-interface=ether2 \
#     comment="natfwd hairpin: source from the appliance so the cloud SG accepts it"

/system clock
set time-zone-name=@@TIMEZONE@@
