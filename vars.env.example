# Copy to vars.env and fill in. vars.env is gitignored - it holds the PSK.

# --- Alibaba side (MikroTik CHR) ---
CHR_PUBLIC_IP=203.0.113.10          # EIP, from terraform output public_ip
CHR_PRIVATE_IP=10.0.0.10            # ether1 address (public vswitch)
CHR_SSH_PORT=7822
CHR_WINBOX_PORT=7881
LOCAL_ASN=64513
LOCAL_PUBLIC_SUBNET=10.0.0.0/24     # public vswitch CIDR
LOCAL_PRIVATE_SUBNET=10.0.10.0/24   # private vswitch CIDR
VPC_SUPERNET=10.0.0.0/18

# --- Azure side (pfSense) ---
PEER_PUBLIC_IP=198.51.100.20        # Azure public IP
PEER_PRIVATE_IP=10.1.0.4            # pfSense WAN address
PEER_ASN=64512
PEER_PUBLIC_SUBNET=10.1.0.0/26
PEER_PRIVATE_SUBNET=10.1.1.0/24
VNET_SUPERNET=10.1.0.0/18

# --- Tunnel ---
CHR_TUNNEL_IP=169.254.100.2
PEER_TUNNEL_IP=169.254.100.1
TUNNEL_NETWORK=169.254.100.0
TUNNEL_MTU=1400
TIMEZONE=Asia/Jakarta

# --- Secret ---
# Generate: openssl rand -base64 32
IPSEC_PSK=CHANGE_ME
